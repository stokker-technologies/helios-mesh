{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --locked --quiet --project tools/python python -m helios_mesh_tools.stkr --optional project hook post",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --locked --quiet --project tools/python python -m helios_mesh_tools.stkr --optional project hook pre",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --locked --quiet --project tools/python python -m helios_mesh_tools.stkr --optional project hook start",
            "timeout": 7200
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --locked --quiet --project tools/python python -m helios_mesh_tools.stkr --optional project hook stop",
            "timeout": 7200
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Monitor",
      "Skill",
      "Agent"
    ]
  }
}
