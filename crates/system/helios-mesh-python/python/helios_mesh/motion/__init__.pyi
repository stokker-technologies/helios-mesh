@final
class Kind:
    ROTATIONAL: ClassVar[Kind]
    TRANSLATIONAL: ClassVar[Kind]
    @property
    def name(self) -> str: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Target:
    @staticmethod
    def rotational(microdegrees: int) -> Target: ...
    @staticmethod
    def translational(micrometres: int) -> Target: ...
    @property
    def kind(self) -> Kind: ...
    @property
    def microdegrees(self) -> int | None: ...
    @property
    def micrometres(self) -> int | None: ...
    @property
    def degrees(self) -> float | None: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object, /) -> bool: ...

@final
class Delta:
    @staticmethod
    def rotational(microdegrees: int) -> Delta: ...
    @staticmethod
    def translational(micrometres: int) -> Delta: ...
    @property
    def kind(self) -> Kind: ...
    @property
    def microdegrees(self) -> int | None: ...
    @property
    def micrometres(self) -> int | None: ...
    @property
    def degrees(self) -> float | None: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object, /) -> bool: ...

@final
class Description:
    @property
    def channel(self) -> ChannelId: ...
    @property
    def kind(self) -> Kind: ...
    @property
    def minimum(self) -> int: ...
    @property
    def maximum(self) -> int: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object, /) -> bool: ...

@final
class Timing:
