@final
class StepperConfig:
    def __new__(
        cls,
        *,
        steps: int,
        microsteps: int,
        max_speed: int,
        max_acceleration: int,
        moving_pwm: int,
        holding_pwm: int,
        reversed: bool = False,
    ) -> StepperConfig: ...
    @property
    def steps(self) -> int: ...
    @property
    def microsteps(self) -> int: ...
    @property
    def reversed(self) -> bool: ...
    @property
    def max_speed(self) -> int: ...
    @property
    def max_acceleration(self) -> int: ...
    @property
    def moving_pwm(self) -> int: ...
    @property
    def holding_pwm(self) -> int: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object, /) -> bool: ...

@final
class Axis:
    @property
    def id(self) -> ChannelId: ...
    @property
    def description(self) -> Description: ...
    async def turn(self, degrees: float, *, speed: int | None = None, acceleration: int | None = None) -> OperationSnapshot: ...
    async def move_to(self, degrees: float, *, speed: int | None = None, acceleration: int | None = None) -> OperationSnapshot: ...
    async def zero(self) -> OperationSnapshot: ...
    async def stop(self) -> OperationSnapshot: ...
    async def start_turn(self, degrees: float, *, speed: int | None = None, acceleration: int | None = None) -> Operation: ...
    async def start_move_to(self, degrees: float, *, speed: int | None = None, acceleration: int | None = None) -> Operation: ...
    async def start_zero(self) -> Operation: ...
    async def start_stop(self) -> Operation: ...
    def __repr__(self) -> str: ...

@final
class AxesGuard:
    @property
    def axes(self) -> list[Axis]: ...
    async def turn_together(self, degrees: list[float]) -> list[OperationSnapshot]: ...
    async def start_turn_together(self, degrees: list[float]) -> list[Operation]: ...
    async def __aenter__(self) -> list[Axis]: ...
    async def __aexit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: object | None,
    ) -> bool: ...
    def __repr__(self) -> str: ...

